# Reference environment for a separately provisioned AWS staging service.
# NOT a working production deployment: verified authentication and release gates remain.
NODE_ENV=production
ENABLE_DEV_AUTH=false
PORT=3000
HOST=0.0.0.0
DATABASE_URL=
REDIS_URL=
# Secret-manager values: 32-byte base64 AES key and independent >=32-character signing key.
DATA_ENCRYPTION_KEY=
AUDIO_SIGNING_KEY=
CORS_ORIGINS=https://admin.example.com
S3_BUCKET=
S3_REGION=ap-south-1
# Leave endpoint unset for AWS S3. Use the ECS task IAM role, not static AWS keys.
S3_SERVER_SIDE_ENCRYPTION=AES256
STT_HTTP_URL=
STT_API_KEY=
TRANSLATION_HTTP_URL=
TRANSLATION_API_KEY=
TRANSLATION_BEARER_KEY=
TTS_HTTP_URL=
TTS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
GOOGLE_TRANSLATE_API_KEY=
BILLING_VERIFICATION_URL=
BILLING_VERIFICATION_KEY=
BILLING_PROVIDERS=
BILLING_WEBHOOK_SECRET=
AI_MODEL_VERSION=
AI_PRICING_VERSION=
AI_PRICING_CONFIRMED=false
GLOBAL_DAILY_AI_BUDGET_USD=
GLOBAL_MONTHLY_AI_BUDGET_USD=
# Set these to verified provider prices and measure actual invoices.
STT_USD_PER_SECOND=
TRANSLATION_USD_PER_CHARACTER=
TTS_USD_PER_CHARACTER=
