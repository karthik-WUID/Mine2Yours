{
  "name": "@mine2yourlingo/api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "node scripts/dev.mjs",
    "test": "npm run build && tsx --test test/*.test.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "cost:estimate": "node scripts/cost-estimate.mjs",
    "test:postgres": "npm run build && node test/postgres-integration.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "7.10.0",
    "bullmq": "5.61.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "17.2.2",
    "helmet": "8.1.0",
    "ioredis": "5.7.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.22.0",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/ws": "8.18.1",
    "prisma": "6.16.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "effect": "3.20.0",
    "js-yaml": "5.4.3"
  },
  "packageManager": "npm@11.21.0",
  "allowScripts": {
    "@prisma/client@6.16.2": true,
    "@prisma/engines@6.16.2": true,
    "prisma@6.16.2": true,
    "esbuild@0.25.12": true,
    "msgpackr-extract@3.0.4": true,
    "fsevents@2.3.3": true,
    "@scarf/scarf": false
  }
}
