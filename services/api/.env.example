NODE_ENV=development
PORT=3000
HOST=127.0.0.1
ENABLE_DEV_AUTH=true
# Set your own dev admin key to sign in to aggregates; never ship this in a mobile app.
DEV_ADMIN_KEY=
DEV_DATA_DIR=.local/api
# Generate with node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))"
# Local mode generates its own development key. Production requires a managed key.
DATA_ENCRYPTION_KEY=
AUDIO_SIGNING_KEY=
# Leave DATABASE_URL unset ONLY for the encrypted isolated development store.
DATABASE_URL=
REDIS_URL=
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
INVITE_BASE_URL=mine2yourlingo://join
MESSAGE_RETENTION_DAYS=30
# Optional JSON plan array; validate pricing and quotas with pilot usage.
PLANS_JSON=
# Configure a verified Twilio Verify service for genuine phone authentication.
GLOBAL_DAILY_OTP_REQUEST_LIMIT=200
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Interchangeable STT contract: POST {audioBase64,mimeType,language} -> {text}
STT_HTTP_URL=
STT_API_KEY=
# LibreTranslate compatible POST /translate. Verify model language support yourself.
GOOGLE_TRANSLATE_API_KEY=
TRANSLATION_HTTP_URL=
TRANSLATION_API_KEY=
TRANSLATION_BEARER_KEY=
# Interchangeable TTS contract: POST {text,language,voice} -> {audioBase64,mimeType}
TTS_HTTP_URL=
TTS_API_KEY=
TTS_VOICE=
# Optional Sarvam for Pro subscribers only. Keys remain on the API server.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v4
SARVAM_TRANSLATION_MODEL=sarvam-translate:v1
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=
# Optional real OpenAI STT/TTS adapters; no model enabled by default.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_STT_MODEL=
OPENAI_TTS_MODEL=
AI_MODEL_VERSION=
GLOSSARY_VERSION=none
AI_TIMEOUT_MS=20000
# Conservative DEVELOPMENT estimates; replace with contracted pricing before deployment.
# Set true ONLY after reviewing provider prices; priced calls fail closed otherwise.
AI_PRICING_CONFIRMED=false
# Caps must be finite and nonnegative. Zero pauses paid work; invalid caps fail closed.
GLOBAL_DAILY_AI_BUDGET_USD=10
GLOBAL_MONTHLY_AI_BUDGET_USD=100
AI_PRICING_VERSION=development-conservative-estimate-v1
STT_USD_PER_SECOND=0.0002
TRANSLATION_USD_PER_CHARACTER=0.00002
TTS_USD_PER_CHARACTER=0.00005
# Standard AWS credential chain; IAM role preferred in production.
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_SERVER_SIDE_ENCRYPTION=AES256
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Trusted server-side billing gateway, not client declared payment success.
BILLING_VERIFICATION_URL=
BILLING_VERIFICATION_KEY=
BILLING_PROVIDERS=
BILLING_WEBHOOK_SECRET=
